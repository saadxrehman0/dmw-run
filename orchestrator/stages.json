{
 "_doc": "Stages of one edition run (plan doc, 'The pipeline, stage by stage', signed off 25 Nov 2026). Times are PKT. needs: stage -> 'done' (must succeed) or 'finished' (done, failed or blocked). gate: a gate id that must be answered (by Saad or by the run's default). ready: a command that exits 0 once the stage's input is in; late: an alert if not ready by then. repeat: run in rounds at the times in 'at' (or every N minutes until 'until'). cutoff: alert if the stage is not done by then. tools: what the headless session may use (permission mode dontAsk).",
 "hard_stop": "12:30",
 "heartbeat_minutes": 5,
 "max_attempts": 2,
 "stages": [
  {"id": "S0", "name": "Preflight", "start": "08:55", "needs": {}, "timeout_min": 5,
   "tools": ["Read", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)"]},
  {"id": "S1", "name": "Content (news sweep, TASI and Global bullets, news Doc, pick card)", "start": "09:00",
   "needs": {"S0": "finished"}, "timeout_min": 20,
   "tools": ["Read", "Write", "Edit", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)",
             "WebFetch", "WebSearch", "mcp__claude_ai_Claude_Docs"]},
  {"id": "S2", "name": "Decks (build EN and AR on Template v2)", "start": "09:00",
   "needs": {"S0": "finished"}, "timeout_min": 20,
   "ready": ["{PY}", "{REPO}/scripts/find_inputs.py", "--day", "{DAY}", "--need", "data"],
   "late": {"at": "09:10", "text": "Data file not in the day folder at 9:10. S1 goes ahead; the decks build the moment it lands."},
   "tools": ["Read", "Write", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)",
             "Bash(powershell *)"]},
  {"id": "S3", "name": "Commentary (read the pick, fill both decks)", "start": "09:00",
   "needs": {"S1": "done", "S2": "done"}, "gate": "pick", "timeout_min": 20,
   "tools": ["Read", "Write", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)",
             "mcp__claude_ai_Claude_Docs"]},
  {"id": "S4", "name": "Results and late news", "start": "10:03", "needs": {"S0": "finished"},
   "repeat": {"at": ["10:03", "10:10"]}, "timeout_min": 9,
   "tools": ["Read", "Write", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)",
             "WebFetch"]},
  {"id": "S5", "name": "Finals (checks, PDFs, EMAIL MB, reviewer)", "start": "10:10",
   "needs": {"S3": "done", "S4": "finished"}, "timeout_min": 12, "cutoff": "10:20",
   "tools": ["Read", "Write", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)",
             "Bash(powershell *)"]},
  {"id": "S6", "name": "Next edition prep (calendar file, write-up)", "start": "10:20",
   "needs": {"S5": "finished"}, "timeout_min": 40,
   "tools": ["Read", "Write", "Glob", "Grep", "Bash(python *)", "Bash(python3 *)", "Bash(py *)",
             "WebFetch"]}
 ]
}
